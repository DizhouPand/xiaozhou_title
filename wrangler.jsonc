{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaozhou-title",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-cloudflare.js"
  },
  "assets": {
    "directory": "./dist/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
